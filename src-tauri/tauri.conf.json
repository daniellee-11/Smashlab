{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmashLab",
  "identifier": "com.smashlab.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run serve",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SmashLab · 羽毛球动作分析",
        "width": 460,
        "height": 880,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
